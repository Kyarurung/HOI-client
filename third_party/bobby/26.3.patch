index 0000000..8aad073
--- /dev/null
+++ b/src/gametest/java/de/johni0702/minecraft/bobby/BobbyTerrainTest.java
@@ -0,0 +1,60 @@
+package de.johni0702.minecraft.bobby;
+
+import de.johni0702.minecraft.bobby.ext.ClientChunkCacheExt;
+import net.fabricmc.fabric.api.client.gametest.v1.FabricClientGameTest;
+import net.fabricmc.fabric.api.client.gametest.v1.context.ClientGameTestContext;
+import net.minecraft.core.BlockPos;
+import net.minecraft.world.level.ChunkPos;
+import net.minecraft.world.level.block.Blocks;
+import net.minecraft.world.level.chunk.status.ChunkStatus;
+
+public final class BobbyTerrainTest implements FabricClientGameTest {
+    @Override
+    public void runTest(ClientGameTestContext context) {
+        context.runOnClient(client -> client.options.renderDistance().set(16));
+        try (var world = context.worldBuilder().create()) {
+            world.getServer().runCommand("gamemode spectator @a");
+            world.getServer().runCommand("tp @a 8 90 8");
+            world.getServer().runCommand("fill 0 70 0 15 95 15 minecraft:gold_block");
+            context.waitFor(client -> client.level != null && client.level.getBlockState(new BlockPos(8, 80, 8)).is(Blocks.GOLD_BLOCK));
+            for (int x = 40; x <= 168; x += 32) {
+                world.getServer().runCommand("tp @a " + x + " 90 8 90 5");
+                int chunkX = x / 16;
+                context.waitFor(client -> client.level.getChunkSource().getChunk(chunkX, 0, ChunkStatus.FULL, false) != null);
+                context.waitTicks(20);
+            }
+            context.waitFor(client -> client.level.getChunkSource().getChunk(0, 0, ChunkStatus.FULL, false) instanceof FakeChunk);
+            context.waitTicks(100);
+            context.runOnClient(client -> {
+                if (!client.level.getBlockState(new BlockPos(8, 80, 8)).is(Blocks.GOLD_BLOCK)) throw new AssertionError("Cached terrain lost block data");
+                if (client.options.getEffectiveRenderDistance() != 16) throw new AssertionError("Client viewing distance was capped");
+            });
+            context.takeScreenshot("bobby-cached-terrain-beyond-server-distance");
+            var saved = context.computeOnClient(client -> ((ClientChunkCacheExt) client.level.getChunkSource()).bobby_getFakeChunkManager().getStorage().loadTag(new ChunkPos(0, 0)));
+            if (saved.join().isEmpty()) throw new AssertionError("Chunk was not stored on disk");
+            world.getServer().runCommand("tp @a 600 90 8");
+            context.waitFor(client -> client.level.getChunkSource().getChunk(0, 0, ChunkStatus.FULL, false) == null);
+            world.getServer().runCommand("tp @a 168 90 8 90 5");
+            context.waitFor(client -> client.level.getChunkSource().getChunk(0, 0, ChunkStatus.FULL, false) instanceof FakeChunk);
+            context.runOnClient(client -> {
+                if (!client.level.getBlockState(new BlockPos(8, 80, 8)).is(Blocks.GOLD_BLOCK)) throw new AssertionError("Reloaded cache lost block data");
+            });
+            world.getServer().runCommand("tp @a 8 90 8");
+            context.waitFor(client -> client.level.getChunkSource().getChunk(0, 0, ChunkStatus.FULL, false) != null && !(client.level.getChunkSource().getChunk(0, 0, ChunkStatus.FULL, false) instanceof FakeChunk));
+            world.getServer().runCommand("setblock 8 80 8 minecraft:diamond_block");
+            context.waitFor(client -> client.level.getBlockState(new BlockPos(8, 80, 8)).is(Blocks.DIAMOND_BLOCK));
+            var overworldStorage = context.computeOnClient(client -> ((ClientChunkCacheExt) client.level.getChunkSource()).bobby_getFakeChunkManager().getStorage());
+            world.getServer().runCommand("execute as @a in hoi:atlas_distant_test run tp @s 0 100 0");
+            context.waitFor(client -> client.level.dimension().identifier().toString().equals("hoi:atlas_distant_test"));
+            context.runOnClient(client -> {
+                if (((ClientChunkCacheExt) client.level.getChunkSource()).bobby_getFakeChunkManager() != null) throw new AssertionError("HOI atlas must not reuse stale chunk colours");
+            });
+            world.getServer().runCommand("execute as @a in minecraft:the_nether run tp @s 0 100 0");
+            context.waitFor(client -> client.level.dimension().identifier().toString().equals("minecraft:the_nether"));
+            context.runOnClient(client -> {
+                var manager = ((ClientChunkCacheExt) client.level.getChunkSource()).bobby_getFakeChunkManager();
+                if (manager == null || manager.getStorage() == overworldStorage) throw new AssertionError("Dimensions must use separate caches");
+            });
+        }
+    }
+}
